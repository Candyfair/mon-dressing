{
  "name": "frog-a-porter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "i18next": "^27.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.23",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "tokens:generate": "node scripts/generate-tokens.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  }
}
